// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// schema.prisma

enum HttpMethod {
  GET
  POST
}

enum ValueEnum {
  STRING
  NUMBER
  BOOLEAN
  DATE
  OBJECT
}

enum EndpointStatusEnum {
  ONLINE
  OFFLINE
  UNKNOWN
}

model Base {
  id            Int                @id @default(autoincrement())
  baseUrl       String
}

model Institution {
  id            Int                @id @default(autoincrement())
  name          String
  logo          String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  endpoints     Endpoint[]
  status        EndpointStatusEnum
}

model Endpoint {
  id            Int                @id @default(autoincrement())
  name          String             
  url           String
  headers       Header[]
  requestParams RequestParam[]
  status        EndpointStatusEnum
  method        HttpMethod
  institutionId Int
  institution   Institution        @relation(fields: [institutionId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Header {
  id            Int                @id @default(autoincrement())
  headerkey     String
  headervalue   String
  endpointId    Int
  endpoint      Endpoint           @relation(fields: [endpointId], references: [id])
}

model RequestParam {
  id            Int                @id @default(autoincrement())
  key           String
  value         ValueEnum
  endpointId    Int
  endpoint      Endpoint           @relation(fields: [endpointId], references: [id])
}
